{
    "name": "casper-pos-desktop",
    "version": "1.0.0",
    "main": "electron/main-loader.js",
    "scripts": {
        "dev": "concurrently \"npm run dev:next\" \"wait-on tcp:3001 && npm run dev:electron\"",
        "dev:next": "npx kill-port 3001 && npx rimraf .next && npm run generate:dev && next dev -H 0.0.0.0 -p 3001",
        "dev:electron": "cross-env NODE_ENV=development electron .",
        "build": "next build",
        "start": "next start -H 0.0.0.0 -p 3000",
        "deploy:hq": "ssh root@109.123.247.119 \"cd /var/www/casper-pos-desktop && rm -f .git/refs/remotes/origin/main && git fetch origin && git reset --hard origin/main && (pm2 stop all || true) && rm -rf .next && NODE_OPTIONS='--max-old-space-size=4096' npm run build && pm2 restart all\"",

        "license:bootstrap": "node scripts/bootstrap-license.js",
        "electron:build": "node scripts/build-license.js && npm run build && node scripts/prepare-standalone.js",
        "dist:assets": "node scripts/generate-build-assets.js",
        "compile:bytecode": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/compile-bytecode.js",
        "dist": "npm run dist:assets && npm run compile:bytecode && npm run electron:build && electron-builder",
        "launcher:dist": "cd casper-launcher && npm install && npm run dist",
        "lint": "next lint",
        "seed": "npx tsx scripts/seed.ts",
        "seed:hq": "npm run generate:prod && npx tsx scripts/seed-hq-admin.ts && npm run generate:dev",
        "db:push": "prisma db push",
        "db:studio": "prisma studio",
        "generate:dev": "node scripts/generate-schemas.mjs --generate && node scripts/validate-schema-provider.js",
        "generate:prod": "node scripts/generate-schemas.mjs && prisma generate --schema prisma/schema.cloud.prisma",
        "postinstall": "npm run generate:dev && npx @electron/rebuild -f -w better-sqlite3",
        "rebuild:electron": "npx @electron/rebuild -f -w better-sqlite3",
        "validate:db": "node scripts/validate-database-files.js",
        "prebuild": "npm run generate:prod && npm run validate:db && node scripts/download-postgres.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:sync": "vitest run src/__tests__/sync",
        "test:bridge": "vitest run src/__tests__/hardware-bridge",
        "schema-check": "node scripts/check-schema-types.js"
    },
    "build": {
        "appId": "com.caspererp.app",
        "productName": "Casper POS",
        "copyright": "Copyright آ© 2026 Casper POS",
        "publish": {
            "provider": "generic",
            "url": "https://updates.casper-erp.com/desktop/"
        },
        "asar": true,
        "asarUnpack": [
            ".next/standalone/**/*",
            ".next/standalone/node_modules/**/*",
            "node_modules/prisma/**/*",
            "node_modules/@prisma/**/*",
            "node_modules/@whiskeysockets/baileys/**/*",
            "node_modules/better-sqlite3/**/*",
            "prisma/**/*"
        ],
        "files": [
            "electron/**/*",
            "public/**/*",
            ".next/standalone/**/*",
            ".next/standalone/node_modules/**/*",
            "prisma/**/*",
            "messages/**/*",
            "package.json",
            "node_modules/prisma/**/*",
            "node_modules/@prisma/**/*"
        ],
        "directories": {
            "output": "dist"
        },
        "extraResources": [
            {
                "from": "build/postgresql-setup.exe",
                "to": "postgresql-setup.exe"
            }
        ],
        "win": {
            "target": "nsis",
            "icon": "build/icon.ico"
        },
        "nsis": {
            "include": "build/installer.nsh",
            "oneClick": false,
            "perMachine": true,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "runAfterFinish": true,
            "license": "build/license.txt",
            "installerIcon": "build/installerIcon.ico",
            "uninstallerIcon": "build/uninstallerIcon.ico",
            "installerHeader": "build/installerHeader.bmp",
            "installerSidebar": "build/installerSidebar.bmp",
            "uninstallerSidebar": "build/uninstallerSidebar.bmp",
            "language": "1025"
        }
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@fontsource/cairo": "^5.2.7",
        "@fontsource/inter": "^5.2.8",
        "@prisma/client": "^5.22.0",
        "@prisma/debug": "^7.4.1",
        "@radix-ui/react-avatar": "^1.1.11",
        "@radix-ui/react-checkbox": "^1.3.3",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-progress": "^1.1.8",
        "@radix-ui/react-radio-group": "^1.3.8",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-tabs": "^1.1.13",
        "@tanstack/react-query": "^5.90.21",
        "@whiskeysockets/baileys": "^7.0.0-rc.9",
        "app-builder-bin": "^4.2.0",
        "arabic-reshaper": "^1.1.0",
        "bcryptjs": "^3.0.3",
        "better-sqlite3": "^12.11.1",
        "bidi-js": "^1.0.3",
        "bonjour-service": "^1.3.0",
        "bwip-js": "^4.8.0",
        "bytenode": "^1.5.7",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.1.0",
        "decimal.js": "^10.6.0",
        "dexie": "^4.3.0",
        "electron-serve": "^1.3.0",
        "electron-updater": "^6.8.3",
        "flatpickr": "^4.6.13",
        "framer-motion": "^12.36.0",
        "fs-extra": "^11.2.0",
        "html2canvas": "^1.4.1",
        "ioredis": "^5.11.1",
        "jose": "^6.1.3",
        "jsonwebtoken": "^9.0.3",
        "jspdf": "^4.2.0",
        "jspdf-autotable": "^5.0.7",
        "localtunnel": "^2.0.2",
        "lucide-react": "^0.575.0",
        "next": "14.2.35",
        "next-themes": "^0.4.6",
        "prisma": "^5.22.0",
        "qrcode.react": "^4.2.0",
        "qz-tray": "^2.2.5",
        "react": "^18",
        "react-barcode": "^1.6.1",
        "react-day-picker": "^9.13.2",
        "react-dom": "^18",
        "react-hook-form": "^7.71.1",
        "react-is": "^19.2.4",
        "react-qr-code": "^2.0.21",
        "react-virtuoso": "^4.18.1",
        "recharts": "^3.7.0",
        "server-only": "^0.0.1",
        "sonner": "^2.0.7",
        "stream-browserify": "^3.0.0",
        "tailwind-merge": "^3.5.0",
        "use-debounce": "^10.1.0",
        "xlsx": "^0.18.5",
        "zod": "^4.3.6",
        "zustand": "^5.0.11"
    },
    "devDependencies": {
        "@next/bundle-analyzer": "^14.2.35",
        "@playwright/test": "^1.61.1",
        "@tailwindcss/postcss": "^4.2.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.3.0",
        "@types/pako": "^2.0.4",
        "@types/raf": "^3.4.3",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@types/trusted-types": "^2.0.7",
        "@vitest/coverage-v8": "^4.1.2",
        "concurrently": "^8.2.2",
        "cross-env": "^7.0.3",
        "electron": "^30.0.0",
        "electron-builder": "^26.8.1",
        "fake-indexeddb": "^6.2.5",
        "jimp": "^1.6.0",
        "msw": "^2.13.2",
        "node-mocks-http": "^1.17.2",
        "postcss": "^8.5.6",
        "sharp": "^0.34.5",
        "supertest": "^7.2.2",
        "tailwindcss": "^4.2.0",
        "to-ico": "^1.1.5",
        "typescript": "^5",
        "vitest": "^4.1.2",
        "wait-on": "^7.2.0"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    }
}
